#!/usr/bin/env bash

# Exit immediately if a command exits with a non-zero status.
set -e

# ==============================================================================
# Windows Cross-Compilation Build Script
# ==============================================================================
# This script configures, builds, and packages the iq_tool application for
# Windows x64 using MinGW. It handles dependency paths, architecture overrides,
# and optional hardware modules.
# ==============================================================================

# --- Master Module List ---
# Format: "module_name REQUIRES_LIBUSB=YES/NO"
MODULES=(
    "rtlsdr REQUIRES_LIBUSB=YES"
    "sdrplay REQUIRES_LIBUSB=NO"
    "hackrf REQUIRES_LIBUSB=YES"
    "bladerf REQUIRES_LIBUSB=YES"
    "airspy REQUIRES_LIBUSB=YES"
    "airspyhf REQUIRES_LIBUSB=YES"
    "hydrasdr REQUIRES_LIBUSB=YES"
    "nrsc5 REQUIRES_LIBUSB=NO"
)

# --- Dependency Path ---
DEPS_BASE_PATH="/usr/local/src/windows_deps_files/src"

# --- Automatically find the full paths to the MinGW runtime DLLs ---
host=x86_64-w64-mingw32
MINGW_GCC_DLL=$(${host}-gcc -print-file-name=libgcc_s_seh-1.dll)
MINGW_PTHREAD_DLL=$(${host}-gcc -print-file-name=libwinpthread-1.dll)

# --- Library Paths ---

# libsndfile
SNDFILE_INCLUDE_DIR="${DEPS_BASE_PATH}/libsndfile/include"
SNDFILE_LIBRARY="${DEPS_BASE_PATH}/libsndfile/build-win64/libsndfile.dll.a"
SNDFILE_DLL="${DEPS_BASE_PATH}/libsndfile/build-win64/libsndfile.dll"

# liquid-dsp
LIQUID_INCLUDE_DIR="${DEPS_BASE_PATH}/liquid-dsp/include"
LIQUID_LIB_BASE_PATH="${DEPS_BASE_PATH}/liquid-dsp"

# FFTW
FFTW_DLL="${DEPS_BASE_PATH}/libfftw/build-win64/bin/libfftw3f-3.dll"

# libexpat
EXPAT_INCLUDE_DIR="${DEPS_BASE_PATH}/libexpat/expat/lib"
EXPAT_LIBRARY="${DEPS_BASE_PATH}/libexpat/expat/build-win64/libexpat.dll.a"
EXPAT_DLL="${DEPS_BASE_PATH}/libexpat/expat/build-win64/libexpat-1.dll"

# RTL-SDR
RTLSDR_INCLUDE_DIR="${DEPS_BASE_PATH}/rtl-sdr/include"
RTLSDR_LIBRARY="${DEPS_BASE_PATH}/rtl-sdr/build-win64/src/librtlsdr.dll.a"
RTLSDR_DLL="${DEPS_BASE_PATH}/rtl-sdr/build-win64/src/librtlsdr.dll"

# SDRplay
SDRPLAY_INCLUDE_DIR="${DEPS_BASE_PATH}/sdrplay_api/include"
SDRPLAY_LIBRARY="${DEPS_BASE_PATH}/sdrplay_api/x64/sdrplay_api.lib"

# HackRF
HACKRF_INCLUDE_DIR="${DEPS_BASE_PATH}/hackrf/host/libhackrf/src/"
HACKRF_LIBRARY="${DEPS_BASE_PATH}/hackrf/host/build-win64/libhackrf/src/libhackrf.dll.a"
HACKRF_DLL="${DEPS_BASE_PATH}/hackrf/host/build-win64/libhackrf/src/libhackrf.dll"

# bladeRF
BLADERF_INCLUDE_DIR="${DEPS_BASE_PATH}/bladeRF/include"
BLADERF_LIBRARY="${DEPS_BASE_PATH}/bladeRF/x64/bladeRF.lib"

# NRSC5
NRSC5_INCLUDE_DIR="${DEPS_BASE_PATH}/nrsc5/include"
NRSC5_LIBRARY="${DEPS_BASE_PATH}/nrsc5/build-win64/src/libnrsc5.dll.a"
NRSC5_DLL="${DEPS_BASE_PATH}/nrsc5/build-win64/src/libnrsc5.dll"

# LibUSB (Used by RTL-SDR, HackRF, bladeRF)
LIBUSB_INCLUDE_DIR="${DEPS_BASE_PATH}/libusb/build-win64/include/libusb-1.0/"
LIBUSB_LIBRARY="${DEPS_BASE_PATH}/libusb/build-win64/lib/libusb-1.0.dll.a"
LIBUSB_DLL="${DEPS_BASE_PATH}/libusb/build-win64/bin/libusb-1.0.dll"

# Airspy
AIRSPY_INCLUDE_DIR="${DEPS_BASE_PATH}/airspyone_host/libairspy/src"
AIRSPY_LIBRARY="${DEPS_BASE_PATH}/airspyone_host/build-win64/libairspy/src/libairspy.dll.a"
AIRSPY_DLL="${DEPS_BASE_PATH}/airspyone_host/build-win64/airspy-tools/src/libairspy.dll"

# Airspy HF+
AIRSPYHF_INCLUDE_DIR="${DEPS_BASE_PATH}/airspyhf/libairspyhf/src"
AIRSPYHF_LIBRARY="${DEPS_BASE_PATH}/airspyhf/build-win64/libairspyhf/src/libairspyhf.dll.a"
AIRSPYHF_DLL="${DEPS_BASE_PATH}/airspyhf/build-win64/libairspyhf/src/libairspyhf.dll"

# HydraSDR
HYDRASDR_INCLUDE_DIR="${DEPS_BASE_PATH}/hydrasdr-host/libhydrasdr/src"
HYDRASDR_LIBRARY="${DEPS_BASE_PATH}/hydrasdr-host/build-win64/libhydrasdr/src/libhydrasdr.dll.a"
HYDRASDR_DLL="${DEPS_BASE_PATH}/hydrasdr-host/build-win64/hydrasdr-tools/src/libhydrasdr.dll"

# --- Function to Display Usage ---
usage() {
    echo "Usage: $0 [options] [make arguments]"
    echo
    echo "Required: liquid-dsp Library Version and Target CPU Architecture (choose one):"
    echo "  --avx              Link against the pre-compiled AVX version of liquid-dsp."
    echo "  --avx2             Link against the pre-compiled AVX2 version of liquid-dsp."
    echo
    echo "Optional Build Options:"
    echo "  --with-rtlsdr      Enable and link RTL-SDR support."
    echo "  --with-sdrplay     Enable and link SDRplay support."
    echo "  --with-hackrf      Enable and link HackRF support."
    echo "  --with-bladerf     Enable and link bladeRF support."
    echo "  --with-nrsc5       Enable and link NRSC5 (HD Radio) support."
    echo "  --with-airspy      Enable and link Airspy support."
    echo "  --with-airspyhf    Enable and link Airspy HF+ support."
    echo "  --with-hydrasdr    Enable and link HydraSDR support."
    echo
    echo "Packaging:"
    echo "  --package          Create a distributable .zip file after a successful build."
    echo
    echo "Argument Passthrough:"
    echo "  --cmake-args \"...\" Pass additional quoted arguments to CMake."
    echo
    echo "Other:"
    echo "  -h, --help         Display this help and exit."
    echo
    echo "Any additional arguments are passed directly to 'make' (e.g., -j4)."
    exit 1
}

# --- Parse Command-Line Arguments ---
if [ "$#" -eq 0 ]; then
    usage
fi

MAKE_ARGS=()
while [[ "$#" -gt 0 ]]; do
    case $1 in
        --avx) BUILD_TYPE="avx";;
        --avx2) BUILD_TYPE="avx2";;
        --package) DO_PACKAGE="YES";;
        --cmake-args) CMAKE_EXTRA_ARGS="$2"; shift;;
        -h|--help) usage;;
        --with-*)
            mod_arg="${1#--with-}"
            valid=0
            for entry in "${MODULES[@]}"; do
                read -r mod req <<< "$entry"
                if [ "$mod" == "$mod_arg" ]; then valid=1; break; fi
            done
            if [ $valid -eq 1 ]; then
                # Dynamically set WITH_MODULENAME="ON"
                eval "WITH_${mod_arg^^}=\"ON\""
            else
                echo "Error: Unknown module option '$1'"; usage
            fi
            ;;
        --*) echo "Error: Unknown option '$1'"; usage;;
        *) MAKE_ARGS+=("$1");;
    esac
    shift
done

# --- Validate Required Options ---
if [ -z "$BUILD_TYPE" ]; then
    echo "Error: A liquid-dsp library version and corresponding CPU architecture must be specified."
    echo "Please choose one of the following options:"
    echo "  --avx  (for x86-64-v2 compatible CPUs)"
    echo "  --avx2 (for x86-64-v3 compatible CPUs)"
    exit 1
fi

# --- Determine CPU_TARGET_ARCHITECTURE ---
case "$BUILD_TYPE" in
    avx) CPU_TARGET_ARCHITECTURE="x86-64-v2" ;;
    avx2) CPU_TARGET_ARCHITECTURE="x86-64-v3" ;;
    *) echo "Error: Unknown BUILD_TYPE '$BUILD_TYPE'."; exit 1 ;;
esac

# --- Setup Shared Variables ---
root=$(cd "$(dirname "$0")/.." && pwd)
build_suffix="${BUILD_TYPE}"

# The core libraries included in every build
cmake_opts=(
    "-DCMAKE_SYSTEM_NAME=Windows"
    "-DCMAKE_C_COMPILER=${host}-gcc"
    "-DSNDFILE_INCLUDE_DIR=${SNDFILE_INCLUDE_DIR}"
    "-DSNDFILE_LIBRARY=${SNDFILE_LIBRARY}"
    "-DLIQUID_INCLUDE_DIR=${LIQUID_INCLUDE_DIR}"
    "-DLIQUID_LIBRARY=${LIQUID_LIB_BASE_PATH}/build-win64-${BUILD_TYPE}/libliquid.dll.a"
    "-DEXPAT_INCLUDE_DIR=${EXPAT_INCLUDE_DIR}"
    "-DEXPAT_LIBRARY=${EXPAT_LIBRARY}"
    "-DCPU_TARGET_ARCHITECTURE=${CPU_TARGET_ARCHITECTURE}"
)

# Base DLLs required for every build
DLLS_TO_COPY=(
    "${SNDFILE_DLL}"
    "${LIQUID_LIB_BASE_PATH}/build-win64-${BUILD_TYPE}/libliquid.dll"
    "${EXPAT_DLL}"
    "${FFTW_DLL}"
    "${MINGW_GCC_DLL}"
    "${MINGW_PTHREAD_DLL}"
)

# --- Dynamic Module Injection ---
# Helper function to inject module CMake variables without copy-pasting
inject_module() {
    local name=$1 inc_dir=$2 lib_path=$3
    cmake_opts+=("-DWITH_${name}=ON" "-D${name}_INCLUDE_DIR=${inc_dir}" "-D${name}_LIBRARY=${lib_path}")
}

NEEDS_LIBUSB=0
for entry in "${MODULES[@]}"; do
    read -r mod req <<< "$entry"
    var_name="WITH_${mod^^}"

    # If the user passed the flag for this module...
    if [ -n "${!var_name}" ]; then
        build_suffix+="-${mod}"

        # Dynamically inject the CMake vars
        inc_var="${mod^^}_INCLUDE_DIR"
        lib_var="${mod^^}_LIBRARY"
        inject_module "${mod^^}" "${!inc_var}" "${!lib_var}"

        # Dynamically check if a DLL variable exists and add it (skip nrsc5 intentionally)
        dll_var="${mod^^}_DLL"
        if [ -n "${!dll_var}" ] && [ "$mod" != "nrsc5" ]; then
            DLLS_TO_COPY+=("${!dll_var}")
        fi

        # Check if it requires LibUSB
        if [ "$req" == "REQUIRES_LIBUSB=YES" ]; then
            NEEDS_LIBUSB=1
        fi
    fi
done

if [ $NEEDS_LIBUSB -eq 1 ]; then
    cmake_opts+=("-DLIBUSB_INCLUDE_DIR=${LIBUSB_INCLUDE_DIR}" "-DLIBUSB_LIBRARY=${LIBUSB_LIBRARY}")
    DLLS_TO_COPY+=("${LIBUSB_DLL}")
fi

if [ -n "$CMAKE_EXTRA_ARGS" ]; then
    read -r -a CMAKE_EXTRA_ARGS_ARRAY <<< "$CMAKE_EXTRA_ARGS"
    cmake_opts+=("${CMAKE_EXTRA_ARGS_ARRAY[@]}")
fi

# --- Execute Build ---
prefix="${root}/build-win64-${build_suffix}"
echo "--- Configuring and Building in ${prefix} ---"
mkdir -p "${prefix}"
cd "${prefix}"
cmake "${cmake_opts[@]}" ..
make "${MAKE_ARGS[@]}"

# --- Packaging ---
if [ "$DO_PACKAGE" = "YES" ]; then
    echo "--- Packaging distributable ZIP file ---"
    dist_dir="${prefix}/iq_tool_win64"
    zip_file_name="iq_tool_${build_suffix}_win64.zip"

    rm -rf "${dist_dir}"
    mkdir -p "${dist_dir}"

    echo "Copying executable, license, and documentation..."
    cp "${prefix}/iq_tool.exe" "${dist_dir}/"
    cp "${root}/LICENSE" "${dist_dir}/"
    cp "${root}/README.md" "${dist_dir}/"

    if [ -f "${root}/iq_tool_presets.conf" ]; then
        cp "${root}/iq_tool_presets.conf" "${dist_dir}/"
    else
        touch "${dist_dir}/iq_tool_presets.conf"
    fi

    echo "Copying required DLLs..."
    for dll in "${DLLS_TO_COPY[@]}"; do
        if [ -f "$dll" ]; then
            cp "$dll" "${dist_dir}/"
        else
            echo "Warning: Expected DLL not found: $dll"
        fi
    done

    echo "Creating ZIP archive: ${zip_file_name}"
    cd "${dist_dir}"
    zip -r "../${zip_file_name}" *

    echo "Packaging complete!"
    echo "Distribution file created at: ${prefix}/${zip_file_name}"

    if [ -n "$WITH_NRSC5" ]; then
        echo "----------------------------------------------------------------------"
        echo "NOTICE: 'libnrsc5.dll' was intentionally excluded from this ZIP."
        echo "        After extracting the package, please manually copy"
        echo "        ${NRSC5_DLL}"
        echo "        into your extracted program folder."
        echo "----------------------------------------------------------------------"
    fi
fi
